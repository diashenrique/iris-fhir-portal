    // Spike 3.6: run in FHIRSERVER (iris session iris -U FHIRSERVER < queries.script). Average of 5 runs per query.
set R="HSFHIR_X0001_R.Rsrc",S="HSFHIR_X0001_S.Observation",pid="Patient/4",code="718-7"
set fx("code")="GetProp(GetJSON(GetAtJSON(GetJSON(GetJSON(r.ResourceString,'code'),'coding'),0),'code'),'code')",fx("disp")="GetProp(GetJSON(GetAtJSON(GetJSON(GetJSON(r.ResourceString,'code'),'coding'),0),'display'),'display')",fx("cat")="GetProp(GetJSON(GetAtJSON(GetJSON(GetJSON(r.ResourceString,'category'),'code'),0),'code'),'code')",fx("subj")="GetProp(GetJSON(r.ResourceString,'subject'),'reference')",fx("dt")="GetProp(GetJSON(r.ResourceString,'effectiveDateTime'),'effectiveDateTime')",fx("val")="GetProp(GetJSON(r.ResourceString,'valueQuantity'),'value')"
set jt="JSON_TABLE(r.ResourceString, '$' COLUMNS (cat VARCHAR(50) PATH '$.category[0].coding[0].code', subj VARCHAR(100) PATH '$.subject.reference', c VARCHAR(50) PATH '$.code.coding[0].code', d VARCHAR(200) PATH '$.code.coding[0].display', dt VARCHAR(50) PATH '$.effectiveDateTime', v NUMERIC(18,6) PATH '$.valueQuantity.value')) jt"
set q("patient functions/today",1)="SELECT r.ResourceString FROM "_R_" r WHERE r.ResourceType = 'Patient' AND r.ResourceId = ? AND r.Deleted = 0",q("patient functions/today",2)=4
set q("options functions/today",1)="SELECT DISTINCT "_fx("code")_" c, "_fx("disp")_" d FROM "_R_" r WHERE r.ResourceType = 'Observation' AND r.Deleted = 0 AND "_fx("cat")_" = 'laboratory' AND "_fx("subj")_" = ? ORDER BY d",q("options functions/today",2)=pid
set q("options json_table",1)="SELECT jt.c, MAX(jt.d) d FROM "_R_" r, "_jt_" WHERE r.ResourceType = 'Observation' AND r.Deleted = 0 AND jt.cat = 'laboratory' AND jt.subj = ? GROUP BY jt.c ORDER BY MAX(jt.d)",q("options json_table",2)=pid
set q("options functions+search",1)="SELECT DISTINCT "_fx("code")_" c, "_fx("disp")_" d FROM "_S_" s JOIN "_R_" r ON r.Key = s.Key WHERE s.patient_Reference = ? AND r.ResourceType = 'Observation' AND r.Deleted = 0 AND "_fx("cat")_" = 'laboratory' ORDER BY d",q("options functions+search",2)=pid
set q("options json_table+search",1)="SELECT jt.c, MAX(jt.d) d FROM "_S_" s JOIN "_R_" r ON r.Key = s.Key, "_jt_" WHERE s.patient_Reference = ? AND r.ResourceType = 'Observation' AND r.Deleted = 0 AND jt.cat = 'laboratory' GROUP BY jt.c ORDER BY MAX(jt.d)",q("options json_table+search",2)=pid
set q("lab functions/today",1)="SELECT "_fx("disp")_" d, "_fx("dt")_" dt, "_fx("val")_" v FROM "_R_" r WHERE r.ResourceType = 'Observation' AND r.Deleted = 0 AND "_fx("cat")_" = 'laboratory' AND "_fx("subj")_" = ? AND "_fx("code")_" = ? ORDER BY dt",q("lab functions/today",2)=pid,q("lab functions/today",3)=code
set q("lab json_table",1)="SELECT jt.d, jt.dt, jt.v FROM "_R_" r, "_jt_" WHERE r.ResourceType = 'Observation' AND r.Deleted = 0 AND jt.cat = 'laboratory' AND jt.subj = ? AND jt.c = ? ORDER BY jt.dt",q("lab json_table",2)=pid,q("lab json_table",3)=code
set q("lab functions+search",1)="SELECT "_fx("disp")_" d, "_fx("dt")_" dt, "_fx("val")_" v FROM "_S_" s JOIN "_R_" r ON r.Key = s.Key WHERE s.patient_Reference = ? AND r.ResourceType = 'Observation' AND r.Deleted = 0 AND "_fx("cat")_" = 'laboratory' AND "_fx("code")_" = ? ORDER BY dt",q("lab functions+search",2)=pid,q("lab functions+search",3)=code
set q("lab json_table+search",1)="SELECT jt.d, jt.dt, jt.v FROM "_S_" s JOIN "_R_" r ON r.Key = s.Key, "_jt_" WHERE s.patient_Reference = ? AND r.ResourceType = 'Observation' AND r.Deleted = 0 AND jt.cat = 'laboratory' AND jt.c = ? ORDER BY jt.dt",q("lab json_table+search",2)=pid,q("lab json_table+search",3)=code
set k="" for { set k=$o(q(k)) q:k=""  set sql=q(k,1),a=$g(q(k,2)),b=$g(q(k,3)) set t=$zh for i=1:1:5 { set r=$s(b'="":##class(%SQL.Statement).%ExecDirect(,sql,a,b),1:##class(%SQL.Statement).%ExecDirect(,sql,a)) set n=0,sig="" while r.%Next() { set n=n+1 set sig=sig_$e(r.%GetData(1),1,12)_"/"_$e(r.%GetData(2),1,25)_"/"_r.%GetData(3)_";" } } w k,": rows=",n," sqlcode=",r.%SQLCODE," avg=",$j($zh-t/5,0,4),"s hash=",$zcrc(sig,7),! }
set r=##class(%SQL.Statement).%ExecDirect(,"SELECT COUNT(*) n, COUNT(DISTINCT x.Key) k FROM "_R_" x") do r.%Next() w "Rsrc rows=",r.n," distinct Key=",r.k,!
set r=##class(%SQL.Statement).%ExecDirect(,"SELECT COUNT(*) n, COUNT(DISTINCT x.Key) k FROM "_S_" x") do r.%Next() w "S.Observation rows=",r.n," distinct Key=",r.k,!
set r=##class(%SQL.Statement).%ExecDirect(,"SELECT TOP 1 patient_Reference FROM "_S_" WHERE patient_Reference IS NOT NULL") do r.%Next() w "patient_Reference sample=",r.%GetData(1),!
set r=##class(%SQL.Statement).%ExecDirect(,"SELECT COUNT(*) n FROM %Dictionary.CompiledClass WHERE Name %STARTSWITH 'HS.FHIRSQL.'") do r.%Next() w "HS.FHIRSQL.* classes=",r.n,!
halt
