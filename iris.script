zn "%SYS"
Do ##class(Security.Users).UnExpireUserPasswords("*")

zn "HSLIB"
set namespace="FHIRSERVER"
Set appKey = "/fhir/r4"
    // JsonAdvSQL replaces the legacy HS.FHIRServer.Storage.Json strategy; its SQL schemas are HSFHIR_X0001_*
Set strategyClass = "HS.FHIRServer.Storage.JsonAdvSQL.InteractionsStrategy"
Set metadataPackages = $lb("hl7.fhir.r4.core@4.0.1")
set appdir="/home/irisowner/dev"

    //Install a Foundation namespace and change to it
Do ##class(HS.Util.Installer.Foundation).Install(namespace)
zn namespace

    // Install elements that are required for a FHIR-enabled namespace
Do ##class(HS.FHIRServer.Installer).InstallNamespace()

    // Install an instance of a FHIR Service into the current namespace
Do ##class(HS.FHIRServer.Installer).InstallInstance(appKey, strategyClass, metadataPackages)

set strategy = ##class(HS.FHIRServer.API.InteractionsStrategy).GetStrategyForEndpoint(appKey)
set config = strategy.GetServiceConfigData()
set config.DebugMode = 4
do strategy.SaveServiceConfigData(config)

zw ##class(HS.FHIRServer.Tools.DataLoader).SubmitResourceFiles(appdir_"/data/fhir/", namespace, appKey)

do $System.OBJ.LoadDir(appdir_"/src","ck",,1)

    // REST API used by labresult.html (FHIR SQL schema)
zn "%SYS"
    // Least privilege of /fhir/api: read the FHIR resource table and run the JSON SQL functions, nothing else
zw ##class(Security.Roles).Create("FHIRPortalAPI", "Least privilege of /fhir/api", "", "")
zn "FHIRSERVER"
zw ##class(%SQL.Statement).%ExecDirect(, "GRANT SELECT ON HSFHIR_X0001_R.Rsrc TO FHIRPortalAPI").%SQLCODE
zw ##class(%SQL.Statement).%ExecDirect(, "GRANT EXECUTE ON SQLUser.GetJSON, SQLUser.GetProp, SQLUser.GetAtJSON TO FHIRPortalAPI").%SQLCODE
zn "%SYS"
set props("AutheEnabled") = 64
set props("NameSpace") = "FHIRSERVER"
set props("IsNameSpaceDefault") = 0
set props("DispatchClass") = "diashenrique.fhir.portal.Dispatch"
set props("MatchRoles")=":%HS_DB_FHIRSERVER:FHIRPortalAPI"
zw ##class(Security.Applications).Create("/fhir/api" , .props)

    // Demo login of the portal (no roles), documented in the README
zw ##class(Security.Users).Create("fhirportal", "", "fhirportal", "FHIR Portal demo user")

    // Portal pages: password login, one session shared with /fhir/r4 and /fhir/api (same GroupById and cookie path)
    // ServeFiles=3 serves the static files only to an authenticated session; the role lets the entry page run
kill props
set props("NameSpace")="FHIRSERVER",props("Path")="/home/irisowner/dev/fhirUI/",props("Recurse")=1,props("AutheEnabled")=32,props("ServeFiles")=3
set props("GroupById")="fhirportal",props("CookiePath")="/fhir/",props("UseCookies")=2,props("MatchRoles")=":%HS_DB_FHIRSERVER"
zw ##class(Security.Applications).Create("/fhir/portal", .props)

    // 8224 = 8192 + 32: no unauthenticated access on the FHIR endpoint; Basic auth keeps working
kill props
set sc=##class(Security.Applications).Get("/fhir/r4",.props)
set props("GroupById")="fhirportal",props("CookiePath")="/fhir/",props("UseCookies")=2,props("AutheEnabled")=8224
zw ##class(Security.Applications).Modify("/fhir/r4", .props)

kill props
set sc=##class(Security.Applications).Get("/fhir/api",.props)
set props("GroupById")="fhirportal",props("CookiePath")="/fhir/",props("UseCookies")=2,props("AutheEnabled")=32
zw ##class(Security.Applications).Modify("/fhir/api", .props)
halt
