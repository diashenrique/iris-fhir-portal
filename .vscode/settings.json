{
  "files.associations": {

    "Dockerfile*": "dockerfile",
    "iris.script": "objectscript"
  },
  "objectscript.conn": {
    "ns": "FHIRSERVER",
    "active": false,
    "username": "_SYSTEM",
    "docker-compose": {
      "service": "iris",
      "internalPort": 52773
    },
